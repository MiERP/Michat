{
  "channel": "knowledge:refresh-document-metadata",
  "transport": "Electron IPC invoke",
  "request": {
    "type": "object",
    "required": ["documentId"],
    "additionalProperties": false,
    "properties": {
      "documentId": { "type": "string", "minLength": 1 }
    }
  },
  "response": {
    "oneOf": [
      {
        "type": "object",
        "required": ["success"],
        "properties": { "success": { "const": true } }
      },
      {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": { "const": false },
          "error": { "type": "string" }
        }
      }
    ]
  },
  "behavior": "Re-extract legal metadata from stored document text without reindexing, modifying chunks, or starting an embedding service. Preserve user-corrected fields only for original legal documents. Return an error when the document is missing."
}
