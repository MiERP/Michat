{
  "name": "michat",
  "version": "2.2.3",
  "description": "Ứng dụng máy tính local-first giúp biến tài liệu thành cơ sở tri thức có thể truy vấn bằng AI.",
  "main": "./out/main/index.js",
  "author": "HAVS",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MiERP/Michat.git"
  },
  "bugs": {
    "url": "https://github.com/MiERP/Michat/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . --max-warnings 0",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "electron:ensure": "node scripts/ensure-electron.cjs",
    "predev": "pnpm run electron:ensure && pnpm run package:deps",
    "dev:electron": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "pnpm run electron:ensure && pnpm run package:deps",
    "build:unpack": "npm run check:version && npm run build && npm run package:deps && electron-builder --dir --config.npmRebuild=false --config.win.signAndEditExecutable=false",
    "build:win": "npm run check:version && npm run build && npm run package:deps && electron-builder --win --config.npmRebuild=false --config.win.signAndEditExecutable=false",
    "package:ci": "npm run check:version && electron-vite build && npm run package:deps && electron-builder --dir --config.npmRebuild=false --config.win.signAndEditExecutable=false && node scripts/check-asar.cjs dist/win-unpacked/resources/app.asar",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && npm run package:deps && playwright test",
    "smoke:packaged": "powershell -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "smoke:parser-worker": "node scripts/smoke-parser-worker.cjs",
    "release:check": "npm run check:version && npm run typecheck && npm run lint && npm test && npm run test:rag && npm run test:coverage && npm run check:security && npm run check:encoding && npm run check:cjk && npm run check:migrations && npm run check:package",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "security:test": "vitest run tests/guards.test.ts tests/ipcValidation.test.ts tests/apiConfigSecrets.test.ts",
    "check:deps": "node scripts/check-dependency-floor.cjs",
    "check:encoding": "node scripts/check-encoding.cjs",
    "check:cjk": "node scripts/check-cjk.cjs",
    "check:migrations": "node scripts/check-migrations.cjs",
    "check:package-contents": "node scripts/check-asar.cjs",
    "check:security": "npm run security:audit && npm run check:deps && npm run check:encoding && npm run security:test",
    "test:rag": "vitest run tests/rag tests/evals",
    "package:deps": "electron-rebuild -w better-sqlite3 -f --build-from-source && node scripts/copy-electron-native.cjs",
    "check:package": "npm run check:version && npm run build && npm run package:deps && npm run smoke:parser-worker && electron-builder --dir --config.npmRebuild=false --config.win.signAndEditExecutable=false && node scripts/check-asar.cjs dist/win-unpacked/resources/app.asar && npm run smoke:packaged",
    "test:node-deps": "pnpm rebuild better-sqlite3",
    "pretest": "npm run test:node-deps",
    "pretest:rag": "npm run test:node-deps",
    "pretest:coverage": "npm run test:node-deps",
    "version:show": "node scripts/version.cjs show",
    "version:bump": "node scripts/version.cjs bump",
    "version:patch": "node scripts/version.cjs bump patch",
    "version:minor": "node scripts/version.cjs bump minor",
    "version:major": "node scripts/version.cjs bump major",
    "version:set": "node scripts/version.cjs set",
    "check:version": "node scripts/version.cjs check",
    "release:build": "npm run check:version && npm run build:win"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.62",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "1.0.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "ai": "^5.0.286",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concat-map": "0.0.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "fd-slicer": "1.1.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.7.2",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^27.3.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.556.0",
    "ms": "2.1.3",
    "officeparser": "^7.1.0",
    "pdfjs-dist": "^6.2.108",
    "pend": "1.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.5.2",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sqlite-vec": "0.1.7-alpha.2",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.2",
    "undici": "^7.30.2",
    "unist-util-visit": "^5.0.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.22",
    "drizzle-kit": "^0.31.8",
    "electron": "^42.11.16",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "pnpm": "11.8.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "resedit": "^3.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.7"
  }
}
