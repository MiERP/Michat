    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "electron:ensure": "node scripts/ensure-electron.cjs",
        "resources:check": "node scripts/check-resources.cjs",
        "resources:check:warn": "node scripts/check-resources.cjs --warn",
        "predev": "pnpm run resources:check:warn && pnpm run electron:ensure && pnpm run package:deps",
        "dev:electron": "electron-vite dev",
        "dev": "electron-vite dev",
        "prebuild": "pnpm run resources:check",
        "build": "npm run typecheck && electron-vite build",
        "postinstall": "pnpm run electron:ensure && electron-builder install-app-deps",
        "build:unpack": "npm run build && npm run package:deps && electron-builder --dir --config.npmRebuild=false",
        "build:win": "npm run build && npm run package:deps && electron-builder --win --config.npmRebuild=false",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "smoke:packaged": "powershell -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
        "release:check": "npm run typecheck && npm run lint && npm test && npm run test:rag && npm run test:coverage && npm run check:security && npm run check:package",
        "security:audit": "pnpm audit --prod --audit-level=high",
        "security:test": "vitest run tests/guards.test.ts tests/ipcValidation.test.ts tests/providerPolicy.test.ts",
        "check:deps": "node scripts/check-dependency-floor.cjs",
        "check:security": "npm run security:audit && npm run check:deps && npm run security:test",
        "test:rag": "vitest run tests/rag tests/evals",
        "package:deps": "electron-rebuild -v 39.8.10 -w better-sqlite3 -f",
        "check:package": "npm run resources:check && npm run build && npm run package:deps && electron-builder --dir --config.npmRebuild=false && npm run smoke:packaged",
        "test:node-deps": "pnpm rebuild better-sqlite3",
        "pretest": "npm run test:node-deps",
        "pretest:rag": "npm run test:node-deps",
        "pretest:coverage": "npm run test:node-deps"
    },
